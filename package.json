{
  "name": "devops-playground",
  "version": "1.0.0",
  "description": "Minimal DevOps showcase API built with Node.js, Express, Docker, Docker Compose and GitHub Actions.",
  "main": "src/server.js",
  "private": true,
  "workspaces": [
    "packages/lab-core",
    "apps/web",
    "apps/control",
    "apps/runner"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "lint": "eslint . --max-warnings 0",
    "test:core": "npm run test --workspace @devops-playground/lab-core",
    "test:web": "npm run test --workspace @devops-playground/web",
    "test:playground": "npm run test:core && npm run test:web && npm run test:control && npm run test:runner",
    "dev:playground": "npm run dev --workspace @devops-playground/web",
    "build:playground": "npm run build --workspace @devops-playground/web",
    "test:e2e:demo": "npm run build:playground && playwright test --project=demo",
    "test:control": "npm run test --workspace @devops-playground/control",
    "test:runner": "npm run test --workspace @devops-playground/runner",
    "playground:demo": "node scripts/playground.js demo",
    "playground:local": "node scripts/playground.js local",
    "playground:status": "node scripts/playground.js status",
    "playground:down": "node scripts/playground.js down"
  },
  "keywords": [
    "devops",
    "docker",
    "github-actions",
    "ci-cd",
    "express"
  ],
  "author": "Nadjide Omar",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/*.test.js"
    ]
  }
}
